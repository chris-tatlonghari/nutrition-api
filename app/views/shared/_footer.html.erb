<footer class="nutrition-footer mt-5">
  <div class="container py-5">
    <div class="row gy-4">
      <div class="col-lg-4 col-md-6">
        <div class="footer-brand d-flex align-items-center gap-2 mb-2">
          <span class="footer-logo">N</span>
          <span class="footer-title">NUTRITIONFAX</span>
        </div>
        <p class="footer-copy mb-2">
          Designed with care.
        </p>
        <p class="footer-meta mb-0">
          Let's make the world 1% healthier.
        </p>
      </div>
      <div class="col-lg-2 col-md-6">
        <h6>Links</h6>
        <ul class="list-unstyled footer-links">
          <li><%= link_to "Home", root_path %></li>
          <li><%= link_to "Services", services_path %></li>
        </ul>
      </div>
      <div class="col-lg-3 col-md-6">
        <h6>Resources</h6>
        <ul class="list-unstyled footer-links">
          <li><%= link_to "About", "#" %></li>
        </ul>
      </div>
      <div class="col-lg-3 col-md-6">
        <h6>Community</h6>
        <ul class="list-unstyled footer-links">
          <li><%= link_to "Contact", "#" %></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mt-4 pt-3">
      <span>© <%= Time.current.year %> NUTRITIONFAX </span>
      <span class="footer-version">v0.0</span>
    </div>
  </div>
</footer>
