<%= form_with model: [:admin, service, food_item], local: true do |f| %>
  <%= render "admin/shared/form_errors", object: food_item %>

  <div class="form-card">
    <h3>Basic Information</h3>

    <div class="mb-3">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-control", placeholder: "e.g., Big Mac, Grande Latte" %>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <%= f.label :serving_size, class: "form-label" %>
        <%= f.number_field :serving_size, class: "form-control", step: "0.01", placeholder: "e.g., 100" %>
      </div>
      <div class="col-md-6 mb-3">
        <%= f.label :serving_unit, class: "form-label" %>
        <%= f.text_field :serving_unit, class: "form-control", placeholder: "e.g., g, oz, ml" %>
      </div>
    </div>
  </div>

  <div class="form-card">
    <h3>Energy & Calories</h3>

    <div class="row">
      <div class="col-md-6 mb-3">
        <%= f.label :calories, class: "form-label" %>
        <%= f.number_field :calories, class: "form-control", placeholder: "e.g., 250" %>
      </div>
      <div class="col-md-6 mb-3">
        <%= f.label :calories_from_fat, class: "form-label" %>
        <%= f.number_field :calories_from_fat, class: "form-control", placeholder: "e.g., 90" %>
      </div>
    </div>
  </div>

  <div class="form-card">
    <h3>Macronutrients</h3>

    <div class="row">
      <div class="col-md-4 mb-3">
        <%= f.label :protein_g, "Protein (g)", class: "form-label" %>
        <%= f.number_field :protein_g, class: "form-control", step: "0.01", placeholder: "e.g., 15.5" %>
      </div>
      <div class="col-md-4 mb-3">
        <%= f.label :carbs_g, "Carbohydrates (g)", class: "form-label" %>
        <%= f.number_field :carbs_g, class: "form-control", step: "0.01", placeholder: "e.g., 30.2" %>
      </div>
      <div class="col-md-4 mb-3">
        <%= f.label :fat_g, "Total Fat (g)", class: "form-label" %>
        <%= f.number_field :fat_g, class: "form-control", step: "0.01", placeholder: "e.g., 12.8" %>
      </div>
    </div>
  </div>

  <div class="form-card">
    <h3>Detailed Nutrients</h3>

    <div class="row">
      <div class="col-md-6 mb-3">
        <%= f.label :saturated_fat_g, "Saturated Fat (g)", class: "form-label" %>
        <%= f.number_field :saturated_fat_g, class: "form-control", step: "0.01", placeholder: "e.g., 5.0" %>
      </div>
      <div class="col-md-6 mb-3">
        <%= f.label :fiber_g, "Fiber (g)", class: "form-label" %>
        <%= f.number_field :fiber_g, class: "form-control", step: "0.01", placeholder: "e.g., 3.2" %>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <%= f.label :sugar_g, "Sugar (g)", class: "form-label" %>
        <%= f.number_field :sugar_g, class: "form-control", step: "0.01", placeholder: "e.g., 8.5" %>
      </div>
      <div class="col-md-6 mb-3">
        <%= f.label :sodium_mg, "Sodium (mg)", class: "form-label" %>
        <%= f.number_field :sodium_mg, class: "form-control", placeholder: "e.g., 450" %>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <%= f.label :cholesterol_mg, "Cholesterol (mg)", class: "form-label" %>
        <%= f.number_field :cholesterol_mg, class: "form-control", placeholder: "e.g., 30" %>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Save Food Item", class: "btn btn-nutrition" %>
    <%= link_to "Cancel", admin_service_path(service), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
