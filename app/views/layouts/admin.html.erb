<!DOCTYPE html>
<html>
  <head>
    <title>Admin - Nutrition API</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <%= render "admin/shared/sidebar" %>

    <div class="admin-main">
      <div class="admin-topbar">
        <div>
          <%= render "admin/shared/breadcrumbs" if content_for?(:breadcrumbs) %>
        </div>
        <div>
          <%= link_to "View Site", root_path, class: "btn btn-sm btn-outline-secondary" %>
        </div>
      </div>

      <div class="admin-content">
        <%= render "admin/shared/flash_messages" %>
        <%= yield %>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
