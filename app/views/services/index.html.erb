<section class="landing-section">
    <div class="landing-header">
        <h1>Services</h1>
        <p>Browse menus by service and drill into nutrition details.</p>
    </div>
    <div class="row g-4">
        <% @services.each do |service| %>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="service-card h-100">
                    <div class="service-card-header">
                        <span class="badge text-bg-light">Explore menu</span>
                    </div>
                    <h3><%= service.name %></h3>
                    <p>See nutrition facts and build a meal with totals.</p>
                    <%= link_to "Browse menu", service_path(service.id), class: "btn btn-outline-light" %>
                </div>
            </div>
        <% end %>
    </div>
</section>
