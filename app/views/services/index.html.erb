<div class="container py-5">
    <div class="mb-5">
        <h1 class="service-title mb-3">Browse</h1>

        <%= search_form_for @q, url: services_path, method: :get, class: "mt-4" do |f| %>
            <div class="search-input-wrapper">
                <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <%= f.search_field :name_cont, placeholder: "Search services...", class: "form-control form-control-lg" %>
                <%= f.hidden_field :category_eq %>
            </div>
        <% end %>

        <div class="control-bar mb-4 mt-4">
            <%= render 'category_filters' %>
        </div>
    </div>

    <% if @services.any? %>
        <div class="row g-4">
            <% @services.each do |service| %>
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="service-card h-100">
                        <div class="service-card-body">
                            <div class="service-card-header">
                                <span class="service-card-category">
                                    <%= (service.category || 'other').humanize.upcase %>
                                </span>
                                <span class="service-card-emoji">
                                    <%= Service::CATEGORY_EMOJIS[(service.category || 'other').to_sym] %>
                                </span>
                            </div>
                            <h3 class="service-card-title"><%= service.name %></h3>
                            <hr class="service-card-divider">
                            <div class="service-card-footer">
                                <span class="service-card-count"><%= service.food_items.count %> items</span>
                                <%= link_to service_path(service.id), class: "service-card-link" do %>
                                    Browse →
                                <% end %>
                            </div>
                        </div>
                    </div>
                </div>
            <% end %>
        </div>
    <% else %>
        <div class="alert alert-warning">
            No services found<% if params.dig(:q, :name_cont).present? %> matching "<%= params.dig(:q, :name_cont) %>"<% end %>.
        </div>
    <% end %>
</div>
