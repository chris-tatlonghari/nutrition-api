<div class="container py-5">
    <div class="mb-5">
        <h1 class="mb-3">Services</h1>
        <p class="text-muted">Browse menus by service and drill into nutrition details.</p>
        <%= search_form_for @q, url: services_path, method: :get, class: "mt-4" do |f| %>
            <div class="search-input-wrapper">
                <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <%= f.search_field :name_cont, placeholder: "Search services...", class: "form-control form-control-lg" %>
            </div>
        <% end %>
    </div>

    <% if @services.any? %>
        <div class="row g-4">
            <% @services.each do |service| %>
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h3 class="card-title"><%= service.name %></h3>
                            <p class="card-text text-muted mb-4">See nutrition facts and build a meal with totals.</p>
                            <%= link_to "Browse menu", service_path(service.id), class: "btn btn-nutrition mt-auto" %>
                        </div>
                    </div>
                </div>
            <% end %>
        </div>
    <% else %>
        <div class="alert alert-info">
            No services found<% if params.dig(:q, :name_cont).present? %> matching "<%= params.dig(:q, :name_cont) %>"<% end %>.
        </div>
    <% end %>
</div>
