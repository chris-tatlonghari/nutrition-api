<% selected_items = @food_items.select { |item| @selected_ids.include?(item.id) } %>

<!-- Shopping Cart Bar -->
<div data-controller="cart">
    <% if selected_items.any? %>
        <!-- Collapsed Shopping Cart Bar -->
        <div class="cart-bar" data-action="click->cart#toggle">
            <div class="cart-bar-header">
                <div>
                    <h5 class="mb-1" style="font-weight: 700;">
                        Your <%= @service.name.humanize %> Meal
                        <span class="badge-count"><%= selected_items.count %></span>
                    </h5>
                    <div class="small" style="opacity: 0.9;">Click to expand details</div>
                </div>
                <button type="button" class="cart-toggle" data-cart-target="toggleIcon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Expanded Cart Details -->
        <div class="cart-details" data-cart-target="details" style="display: none;">
            <h6 class="mb-3" style="font-weight: 700; color: #333;">Items Breakdown</h6>

            <% selected_items.each do |item| %>
                <div class="cart-item" data-cart-item-id="<%= item.id %>">
                    <div class="cart-item-name"><%= item.name %></div>
                    <button type="button" class="cart-item-remove" data-action="click->cart#removeItem" data-item-id="<%= item.id %>">✕</button>
                </div>
            <% end %>
        </div>
    <% else %>
        <!-- Empty State -->
        <div class="cart-bar cart-empty-bar">
            <div class="cart-bar-header">
                <div>
                    <h5 class="mb-1" style="font-weight: 700;">
                        Your choices will appear here.
                    </h5>
                    <div class="small">No items selected yet</div>
                </div>
            </div>
        </div>
    <% end %>
</div>
